[Unattend]
Signature = "$ReactOS$"

UnattendSetupEnabled = yes

DestinationDiskNumber = 0
DestinationPartitionNumber = 1
InstallationDirectory = ReactOS
AutoPartition = 1
FormatPartition = 1
; 0: FAT
; 1: BtrFS
FsType = 0
; 0: Skip installation
; 1: Install on removable media (floppy)
; 2: Install on system partition (for MBR disks: MBR and VBR)
; 3: Install on VBR only (for MBR disks)
BootLoaderLocation = 2

FullName = "Owner"
OrgName = "Org"
ComputerName = "REACTOS"
; AdminPassword = "password"

; TimeZoneIndex lists:
; https://docs.microsoft.com/en-us/previous-versions/windows/embedded/ms912053(v=winembedded.10)
TimeZoneIndex = 85
DisableAutoDaylightTimeSet = 1

; LocaleID lists:
; https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-lcid/a9eac961-e77d-41a6-90a5-ce1a8b0cdb9c
LocaleID = 409

; 0: ReactOS Server
; 1: ReactOS Workstation
; 2: ReactOS Server Core
InstallationType = 0

; yes: Download addons from RAPPS
; no: Don't download addons from RAPPS
RappsDownload = no

[GuiRunOnce]
D:\i386\unattend.bat

[Display]
BitsPerPel = 32
XResolution = 1440
YResolution = 900
VRefresh = 0
